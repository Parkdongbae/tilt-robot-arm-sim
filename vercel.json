{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"정적 사이트: 설치할 것 없음\"",
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/vendor/three/:path*",
